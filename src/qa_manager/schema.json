{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HydratedIronOxide/ESATPlayer/schema/question-deck-v1.schema.json",

  "title": "ESATPlayer Question Deck",
  "description": "Schema for an ESATPlayer question deck.",

  "type": "object",
  "additionalProperties": false,

  "required": [
    "title",
    "questions"
  ],

  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },

    "questions": {
      "type": "array",
      "minItems": 1,

      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "id",
          "subject",
          "difficulty",
          "question",
          "choices",
          "correct_answer"
        ],

        "properties": {
          "id": {
            "description": "Persistent UUID assigned by ESATPlayer. AI-generated decks should set this to null.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "uuid"
              }
            ]
          },

          "subject": {
            "type": "string",
            "enum": [
              "m1",
              "m2",
              "physics"
            ]
          },

          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },

          "question": {
            "type": "string",
            "minLength": 1,
            "description": "Question text. Inline maths uses $...$ and display maths uses $$...$$."
          },

          "choices": {
            "type": "array",
            "minItems": 4,
            "maxItems": 26,
            "uniqueItems": true,

            "items": {
              "type": "string",
              "minLength": 1
            }
          },

          "correct_answer": {
            "type": "string",
            "pattern": "^[A-Z]$",
            "description": "Letter corresponding to the correct choice: A is choices[0], B is choices[1], etc."
          }
        }
      }
    }
  }
}